import 'package:firebase_auth/firebase_auth.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_storage/firebase_storage.dart';
import 'package:flutter/material.dart';
import 'dart:typed_data';
import 'package:image_picker/image_picker.dart';

class AdminQuizInputOnePage extends StatefulWidget {
  @override
  _AdminQuizInputOnePageState createState() => _AdminQuizInputOnePageState();
}

class _AdminQuizInputOnePageState extends State<AdminQuizInputOnePage> {
  final TextEditingController questionController = TextEditingController();
  final List<TextEditingController> answerControllers = 
      List.generate(5, (_) => TextEditingController());
  Uint8List? _webImageBytes;
  bool _isSaving = false;

  // Constants for Firebase collections
  static const String quizCollection = 'SmartTrafficInputOneCollection';
  static const String storagePath = 'quizone_images/';

  Future<String?> uploadImage(Uint8List imageBytes) async {
    try {
      final fileName = '${DateTime.now().millisecondsSinceEpoch}.png';
      final storageRef = FirebaseStorage.instance.ref().child(storagePath + fileName);
      final uploadTask = storageRef.putData(imageBytes);
      final snapshot = await uploadTask.whenComplete(() {});
      return await snapshot.ref.getDownloadURL();
    } catch (e) {
      debugPrint("Зураг байршуулах алдаа: $e");
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text("Зураг байршуулах алдаа: ${e.toString()}"))
      );
      return null;
    }
  }

  Future<void> saveQuestionToFirebase() async {
    final user = FirebaseAuth.instance.currentUser;
print("🟢 Хандалт хийх гэж байгаа хэрэглэгч: ${user?.email}");
    if (_isSaving) return;

    setState(() => _isSaving = true);

    try {
      // Validate inputs
      final question = questionController.text.trim();
      final answers = answerControllers
          .map((controller) => controller.text.trim())
          .where((text) => text.isNotEmpty)
          .toList();

      if (question.isEmpty) {
        throw "Асуулт хоосон байж болохгүй";
      }

      if (answers.isEmpty) {
        throw "Дор хаяж нэг хариулт өгнө үү";
      }

      // Upload image if exists
      String? imageUrl;
      if (_webImageBytes != null) {
        imageUrl = await uploadImage(_webImageBytes!);
        if (imageUrl == null) {
          throw "Зургийг байршуулж чадсангүй";
        }
      }

      // Prepare data
      final quizData = {
        "Question": question,
        "Answer1": answers.isNotEmpty ? answers[0] : "",
        "Answer2": answers.length > 1 ? answers[1] : "",
        "Answer3": answers.length > 2 ? answers[2] : "",
        "Answer4": answers.length > 3 ? answers[3] : "",
        "Answer5": answers.length > 4 ? answers[4] : "",
        "Image": imageUrl ?? "",
        "CreatedAt": FieldValue.serverTimestamp(),
      };

      // Save to Firestore
      final docRef = await FirebaseFirestore.instance
          .collection(quizCollection)
          .add(quizData);

      debugPrint("Асуултыг ID-аар хадгалсан: ${docRef.id}");

      // Clear form after successful save
      questionController.clear();
      for (final controller in answerControllers) {
        controller.clear();
      }
      setState(() => _webImageBytes = null);

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text("Асуултыг амжилттай хадгаллаа!"))
      );
    } catch (e) {
      debugPrint("Хадгалах алдаа: $e");
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text("Error: ${e.toString()}"))
      );
    } finally {
      setState(() => _isSaving = false);
    }
  }

  Future<void> _pickImage() async {
    try {
      final pickedFile = await ImagePicker().pickImage(source: ImageSource.gallery);
      if (pickedFile != null) {
        final bytes = await pickedFile.readAsBytes();
        setState(() => _webImageBytes = bytes);
      }
    } catch (e) {
      debugPrint("Image picker error: $e");
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text("Failed to pick image: ${e.toString()}"))
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Асуулт нэмэх"),
        backgroundColor: Colors.blue[100],  // Blue background for the header
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Container(
          decoration: BoxDecoration(
            color: Colors.blue[100], // Light blue background for the body
            borderRadius: BorderRadius.circular(20),
            boxShadow: [
              BoxShadow(color: Colors.black.withOpacity(0.1), blurRadius: 8, spreadRadius: 2),
            ],
          ),
          padding: const EdgeInsets.all(20),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.center,  // Center the content
            children: [
              SizedBox(height: 20),

              // Question input field centered
              TextField(
                controller: questionController,
                decoration: InputDecoration(
                  labelText: "Асуулт оруулна уу?  ",
                  labelStyle: TextStyle(color: Colors.blue),
                  border: OutlineInputBorder(),
                  filled: true,
                  fillColor: Colors.white,
                ),
              ),
              SizedBox(height: 20),

              const Text("Зураг нэмэх (заавал биш):"),
              const SizedBox(height: 10),

              // Image upload section
              _webImageBytes != null
                  ? Column(
                      children: [
                        Image.memory(_webImageBytes!, height: 130, fit: BoxFit.cover),
                        TextButton(
                          onPressed: () => setState(() => _webImageBytes = null),
                          child: const Text("Зургийг устгах"),
                        ),
                      ],
                    )
                  : ElevatedButton.icon(
                      onPressed: _pickImage,
                      icon: const Icon(Icons.image),
                      label: const Text("Зураг сонгоно уу"),
                    ),
              SizedBox(height: 20),

              // Answer options styled like the question field
              ...List.generate(5, (index) {
                return Padding(
                  padding: const EdgeInsets.only(bottom: 15),
                  child: TextField(
                    controller: answerControllers[index],
                    decoration: InputDecoration(
                      labelText: "Хариулт ${index + 1}",
                      labelStyle: TextStyle(color: Colors.blue),
                      border: OutlineInputBorder(),
                      filled: true,
                      fillColor: Colors.white,
                    ),
                  ),
                );
              }),

              SizedBox(height: 30),

              // Save button styled like the "START" button
              ElevatedButton(
                onPressed: _isSaving ? null : saveQuestionToFirebase,
                style: ElevatedButton.styleFrom(
                  minimumSize: Size(double.infinity, 50),  // Full width button
                  backgroundColor: Colors.white,  // Set the color
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(25),
                  ),
                  side: BorderSide(color: Colors.white, width: 1),  // Border effect
                ),
                child: _isSaving 
                    ? const CircularProgressIndicator()
                    : const Text("Хадгалах", style: TextStyle(fontWeight: FontWeight.bold, color: Colors.blue, fontSize: 15)),
              ),
            ],
          ),
        ),
      ),
    );
  }

  @override
  void dispose() {
    questionController.dispose();
    for (final controller in answerControllers) {
      controller.dispose();
    }
    super.dispose();
  }
}
