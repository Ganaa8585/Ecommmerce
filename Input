import 'package:flutter/material.dart';
import 'dart:typed_data';
import 'package:image_picker/image_picker.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_storage/firebase_storage.dart';

class AdminQuizInputOnePage extends StatefulWidget {
  const AdminQuizInputOnePage({Key? key}) : super(key: key);

  @override
  State<AdminQuizInputOnePage> createState() => _AdminQuizInputOnePageState();
}

class _AdminQuizInputOnePageState extends State<AdminQuizInputOnePage> {
  final TextEditingController questionController = TextEditingController();
  final List<TextEditingController> answerControllers =
      List.generate(5, (_) => TextEditingController());

  Uint8List? _webImageBytes; // Web-д зориулсан зураг хадгалах

  @override
  void dispose() {
    questionController.dispose();
    for (var controller in answerControllers) {
      controller.dispose();
    }
    super.dispose();
  }

  Future<void> _pickImage() async {
    final pickedFile =
        await ImagePicker().pickImage(source: ImageSource.gallery);
    if (pickedFile != null) {
      final bytes =
          await pickedFile.readAsBytes(); // Web-д Uint8List хэлбэрээр авна
      setState(() {
        _webImageBytes = bytes;
      });
    }
  }

  // ✅ ЭНЭ бол хадгалах функц — яг энэ class-ын ДОТОР байрлана
  Future<void> saveQuestionToFirebase({
    required String question,
    required List<String> answers,
    Uint8List? imageBytes,
  }) async {
    try {
      String? imageUrl;

      // Хэрвээ зураг байвал Firebase Storage руу хадгална
      if (imageBytes != null) {
        final storageRef = FirebaseStorage.instance.ref().child(
            "SmartTrafficTestImages/${DateTime.now().millisecondsSinceEpoch}.png");

        // Зураг хадгалахын тулд асинхрон үүрэг гүйцэтгэх
        final uploadTask = await storageRef.putData(imageBytes);

        // Зураг амжилттай хадгалагдсаны дараа URL авах
        imageUrl = await uploadTask.ref.getDownloadURL(); // URL-ийг авна
        print("Зургийн URL: $imageUrl");
      }

      // Firestore-д хадгалах өгөгдлийн бүтэц
      final Map<String, dynamic> data = {
        "Question": question,
        "Answer1": answers.isNotEmpty ? answers[0] : "",
        "Answer2": answers.length > 1 ? answers[1] : "",
        "Answer3": answers.length > 2 ? answers[2] : "",
        "Answer4": answers.length > 3 ? answers[3] : "",
        "Answer5": answers.length > 4 ? answers[4] : "",
        "Image": imageUrl ?? "", // Зургийн URL буюу хоосон утга
        "CreatedAt": FieldValue.serverTimestamp(),
      };

      // Firestore-д өгөгдлийг хадгалах
      await FirebaseFirestore.instance
          .collection('SmartTrafficInputOneCollection')
          .add(data);
      print("Амжилттай хадгаллаа");
    } catch (e) {
      print("🔥 Firebase хадгалах үед алдаа гарлаа: $e");
      rethrow;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Асуулт нэмэх", style: TextStyle(color: Colors.black)),
        backgroundColor: Colors.white,
        elevation: 0,
        iconTheme: IconThemeData(color: Colors.black),
      ),
      body: SingleChildScrollView(
        padding: EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            buildInputField("Асуулт оруулна уу?", questionController),
            SizedBox(height: 20),
            Text("Зураг нэмэх (заавал биш):", style: TextStyle(fontSize: 16)),
            SizedBox(height: 10),
            _webImageBytes != null
                ? Column(
                    children: [
                      ClipRRect(
                        borderRadius: BorderRadius.circular(12),
                        child: Image.memory(_webImageBytes!,
                            height: 180,
                            width: double.infinity,
                            fit: BoxFit.cover),
                      ),
                      TextButton(
                        onPressed: () {
                          setState(() {
                            _webImageBytes = null;
                          });
                        },
                        child: Text("Зураг устгах"),
                      ),
                    ],
                  )
                : ElevatedButton.icon(
                    onPressed: _pickImage,
                    icon: Icon(Icons.image),
                    label: Text("Зураг сонгох"),
                  ),
            SizedBox(height: 20),
            Text("Хариултууд:", style: TextStyle(fontWeight: FontWeight.w600)),
            SizedBox(height: 10),
            ...List.generate(5, (index) {
              return Padding(
                padding: const EdgeInsets.only(bottom: 15),
                child: buildInputField(
                    "Хариулт ${index + 1}", answerControllers[index]),
              );
            }),
            SizedBox(height: 30),
            ElevatedButton(
              onPressed: () async {
                String question = questionController.text.trim();
                List<String> answers = answerControllers
                    .map((c) => c.text.trim())
                    .where((text) => text.isNotEmpty)
                    .toList();

                if (question.isEmpty || answers.isEmpty) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                        content: Text(
                            "Асуулт болон хамгийн багадаа 1 хариулт оруулна уу!")),
                  );
                  return;
                }

                try {
                  await saveQuestionToFirebase(
                    question: question,
                    answers: answers,
                    imageBytes: _webImageBytes,
                  );

                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text("Амжилттай хадгалагдлаа!")),
                  );

                  questionController.clear();
                  for (var c in answerControllers) {
                    c.clear();
                  }
                  setState(() {
                    _webImageBytes = null;
                  });
                } catch (e) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text("Хадгалах үед алдаа гарлаа.")),
                  );
                }
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.blue,
                padding: EdgeInsets.symmetric(vertical: 15, horizontal: 30),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
              ),
              child: Text(
                'Хадгалах',
                style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget buildInputField(String label, TextEditingController controller) {
    return TextFormField(
      controller: controller,
      decoration: InputDecoration(
        labelText: controller.text.isEmpty ? label : null,
        floatingLabelBehavior: FloatingLabelBehavior.never,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(12),
        ),
        filled: true,
        fillColor: Colors.grey.shade100,
      ),
      onChanged: (_) => setState(() {}),
    );
  }
}
